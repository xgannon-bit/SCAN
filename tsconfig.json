{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-evaluation/types/**/*.ts",
    ".next-evaluation/dev/types/**/*.ts",
    ".next-development/types/**/*.ts",
    ".next-development/dev/types/**/*.ts",
    ".next-placement-repair/types/**/*.ts",
    ".next-placement-repair/dev/types/**/*.ts",
    ".next-independent-diagnosis/types/**/*.ts",
    ".next-independent-diagnosis/dev/types/**/*.ts",
    ".next-visual-rebuild/types/**/*.ts",
    ".next-visual-rebuild/dev/types/**/*.ts",
    ".next-visual-processing/types/**/*.ts",
    ".next-visual-processing/dev/types/**/*.ts",
    ".next-full-board/types/**/*.ts",
    ".next-full-board/dev/types/**/*.ts",
    ".next-board-evidence/types/**/*.ts",
    ".next-board-evidence/dev/types/**/*.ts",
    ".next-board-evidence-r02/types/**/*.ts",
    ".next-board-evidence-r02/dev/types/**/*.ts",
    ".next-image-first/types/**/*.ts",
    ".next-image-first/dev/types/**/*.ts",
    ".next-image-registration/types/**/*.ts",
    ".next-image-registration/dev/types/**/*.ts",
    ".next-image-registration-r02/types/**/*.ts",
    ".next-image-registration-r02/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
